PORT=3001
DATABASE_URL=postgresql://user:password@localhost:5432/project_ops
BETTER_AUTH_SECRET=replace-with-a-secure-secret
BETTER_AUTH_URL=http://localhost:3001

# Frontend URL, used to build invitation links
APP_URL=http://localhost:5173

# Invitation emails via Resend (https://resend.com). Leave empty to log invite links to the console instead.
RESEND_API_KEY=
EMAIL_FROM=ProjectOps <invites@your-verified-domain.com>